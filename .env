# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=stdrmp_db
DB_USER=root
DB_PASSWORD=your_password

# JWT Configuration
JWT_SECRET=stdrmp-jwt-secret-debela-kebede-2024-secure-key-9x8y7z
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=stdrmp-refresh-secret-debela-kebede-2024-secure-token-5a4b3c
JWT_REFRESH_EXPIRES_IN=30d

# Email Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@stdrmp.com

# File Upload Configuration
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=pdf,doc,docx
UPLOAD_PATH=./uploads

# Security
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Session Configuration
SESSION_SECRET=your-session-secret-key

# Application
APP_NAME=Smart Talent Discovery and Recruitment Management Platform
APP_TAGLINE=Connecting Talent, Empowering Careers
APP_AUTHOR=Debela Kebede
